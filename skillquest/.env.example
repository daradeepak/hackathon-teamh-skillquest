# Copy this file to .env and fill in your values. Never commit .env.
# PostgreSQL connection string (required)
DATABASE_URL=postgres://xpedition:change-me@localhost:5432/xpedition
# require = TLS with certificate checks (managed databases); no-verify = TLS without checks; leave empty for local
DATABASE_SSL=
# Web server
PORT=8000
HOST=127.0.0.1
# Set both to 1 in production behind an HTTPS reverse proxy
COOKIE_SECURE=0
TRUST_PROXY=0
# Sign-up attempts allowed per address per hour
REGISTER_LIMIT_PER_HOUR=10
